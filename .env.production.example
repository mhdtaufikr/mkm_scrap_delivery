APP_NAME="MKM Scrap Delivery"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://e-scrap.ptmkm.co.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mkm_scrap_delivery
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=e-scrap.ptmkm.co.id
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=e_scrap_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=e_scrap_cache

MAIL_MAILER=smtp
# Port 587 memakai SMTP + STARTTLS saat server mendukungnya.
MAIL_SCHEME=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=CHANGE_ME@ptmkm.co.id
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=e-scrap.ptmkm.co.id

VITE_APP_NAME="${APP_NAME}"

SSO_ENABLED=true
AZURE_AD_CLIENT_ID=CHANGE_ME
AZURE_AD_CLIENT_SECRET=CHANGE_ME
AZURE_AD_TENANT_ID=CHANGE_ME
AZURE_AD_REDIRECT_URI=https://e-scrap.ptmkm.co.id/auth/azure/callback
SSO_BOOTSTRAP_ADMIN_EMAIL=mkm02120@ptmkm.co.id

# Isi hanya setelah atribut Section Microsoft Graph dipastikan oleh IT.
SSO_SECTION_ATTRIBUTE=

LOCAL_DEMO_ACCOUNTS=false
LOCAL_DEMO_PASSWORD=
WORKFLOW_INITIAL_PASSWORD=
WORKFLOW_TRIAL_MODE=false
WORKFLOW_TRIAL_RECIPIENT=
ACCESS_REQUEST_RECIPIENT=muhammad.taufik@ptmkm.co.id
